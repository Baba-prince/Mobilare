# Copy to .env and fill locally. Never commit .env.

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_DB_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Stripe (use sk_live_ / pk_live_ for production)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Google Maps Platform (Geocoding, Places, Directions, Maps JS)
# Enable APIs: Maps JavaScript API, Geocoding API, Places API, Directions API
# Restrict server key by IP; browser key by HTTP referrer (mobilare.co.uk/*)
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Messaging / email / AI (Admin CRM)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
RESEND_KEY=
RESEND_FROM=Mobilare <noreply@mobilare.co.uk>
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

CORS_ORIGIN=https://mobilare.co.uk,https://www.mobilare.co.uk
SUCCESS_URL=https://mobilare.co.uk/booking-success
CANCEL_URL=https://mobilare.co.uk/booking-cancel
